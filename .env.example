# Copy to .env and fill in. Never commit the real file.

PORT=3000

# Absolute public base for links that go into email. Get this wrong and every
# confirmation link points at localhost.
PUBLIC_URL=https://peptra.com

# Bearer token for GET /api/waitlist/export.csv.
# CSV export stays disabled while this is unset.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# Set to 1 when running behind a TLS-terminating proxy (every managed host).
# Without it the rate limiter sees the proxy's address instead of the
# visitor's and limits everyone as one client.
TRUST_PROXY=1

# Where the event log is appended. Must be on a persistent volume.
WAITLIST_FILE=/data/waitlist.jsonl

# --- Email -------------------------------------------------------------
# console  : prints the confirmation link to the log, sends nothing (dev only)
# postmark : requires POSTMARK_TOKEN
# resend   : requires RESEND_API_KEY
MAIL_PROVIDER=console
MAIL_FROM=Peptra <hello@peptra.com>
POSTMARK_TOKEN=
RESEND_API_KEY=

# --- Abuse limits ------------------------------------------------------
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=600000
