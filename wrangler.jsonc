{
  // Static-assets-only Worker: there is no `main`, so Cloudflare serves
  // ./public directly rather than running any Worker code. This is what
  // makes "Workers Builds" succeed on a repo with no Worker in it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peps",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public"
  }
}
